{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
        }
      ]
    },
    {
      "source": "/download-cv.pdf",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"Shaik_Arham_Saquib_DataPoint.pdf\""
        },
        {
          "key": "Content-Type",
          "value": "application/pdf"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/download-cv.pdf",
      "destination": "/assets/Shaik_Arham_Saquib_DataPoint.pdf"
    }
  ],
  "functions": {
    "api/download-cv.js": {
      "includeFiles": "assets/Shaik_Arham_Saquib_DataPoint.pdf"
    }
  }
}
